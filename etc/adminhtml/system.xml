<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mago">
            <group id="attribute_access" translate="label comment" type="text" sortOrder="36"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Product Attribute Access</label>
                <comment>The store default for what the assistant may change. Each product attribute can override it on its edit page.</comment>
                <field id="set_values" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Set Attribute Values on Products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="add_options" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Add Attribute Options</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
